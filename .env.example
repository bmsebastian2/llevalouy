# URL pública del sitio (se usa para og:image absolutas)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API. SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp de la tienda, formato internacional sin "+" (ej: 59899123456). Recibe los pedidos.
WHATSAPP_NUMBER=

# Panel /admin. La contraseña la elegís vos (mínimo 12 caracteres recomendado).
ADMIN_PASSWORD=
# Clave aleatoria de 32+ caracteres para firmar la sesión. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
